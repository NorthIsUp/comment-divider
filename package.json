{
  "name": "comment-divider-updated",
  "displayName": "Comment Divider Updated",
  "description": "Divide your code by sections with styled separators.",
  "version": "0.5.1",
  "publisher": "northisup",
  "license": "GPL-3.0",
  "icon": "img/logo_256.png",
  "scripts": {
    "vsce:build": "bun vsce package",
    "vsce:publish": "bun vsce publish",
    "install-extension": "code --install-extension",
    "vscode:prepublish": "bun compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "bun compile # && bun lint",
    "test": "jest # && bun vscode-test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/northisup/comment-divider"
  },
  "bugs": {
    "url": "https://github.com/northisup/comment-divider/issues"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "comment",
    "separator",
    "divider",
    "section"
  ],
  "contributes": {
    "commands": [
      {
        "command": "comment-divider.makeSubHeader",
        "title": "Comment Divider: Make Subheader"
      },
      {
        "command": "comment-divider.makeMainHeader",
        "title": "Comment Divider: Make Main Header"
      },
      {
        "command": "comment-divider.insertSolidLine",
        "title": "Comment Divider: Insert Solid Line"
      }
    ],
    "keybindings": [
      {
        "command": "comment-divider.makeSubHeader",
        "key": "alt+x",
        "when": "editorTextFocus"
      },
      {
        "command": "comment-divider.makeMainHeader",
        "key": "shift+alt+x",
        "when": "editorTextFocus"
      },
      {
        "command": "comment-divider.insertSolidLine",
        "key": "alt+y",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Comment Divider",
      "properties": {
        "comment-divider.length": {
          "type": "number",
          "default": 80,
          "description": "Set line length for all dividers."
        },
        "comment-divider.shouldLengthIncludeIndent": {
          "type": "boolean",
          "default": false,
          "description": "Set whether the divider will be shrink consider indent size, or will be always fixed length."
        },
        "comment-divider.mainHeaderFiller": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "default": "-",
          "description": "Set symbol for main header line filling (only one)."
        },
        "comment-divider.mainHeaderHeight": {
          "type": "string",
          "enum": [
            "block",
            "line"
          ],
          "default": "block",
          "description": "Set main header vertical style."
        },
        "comment-divider.mainHeaderAlign": {
          "type": "string",
          "enum": [
            "center",
            "left",
            "right"
          ],
          "default": "center",
          "description": "Set main header text align."
        },
        "comment-divider.mainHeaderTransform": {
          "type": "string",
          "enum": [
            "uppercase",
            "lowercase",
            "titlecase",
            "none"
          ],
          "default": "none",
          "description": "Set main header text transform style."
        },
        "comment-divider.subheaderFiller": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "default": "-",
          "description": "Set symbol for subheader line filling (only one)."
        },
        "comment-divider.subheaderHeight": {
          "type": "string",
          "enum": [
            "block",
            "line"
          ],
          "default": "line",
          "description": "Set subheader vertical style."
        },
        "comment-divider.subheaderAlign": {
          "type": "string",
          "enum": [
            "center",
            "left",
            "right"
          ],
          "default": "center",
          "description": "Set subheader text align."
        },
        "comment-divider.subheaderTransform": {
          "type": "string",
          "enum": [
            "uppercase",
            "lowercase",
            "titlecase",
            "none"
          ],
          "default": "none",
          "description": "Set subheader text transform style."
        },
        "comment-divider.lineFiller": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "default": "-",
          "description": "Set symbol for solid line filling."
        },
        "comment-divider.languagesMap": {
          "type": "object",
          "uniqueItems": true,
          "patternProperties": {
            "^[\\w\\-\\.]+$": {
              "type": "array",
              "description": "Name of the language mode given by VSCode",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "Defines what characters will be used as comment line limiters for special languages. It also overrides the default preset."
        }
      }
    }
  },
  "main": "./out/extension",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.13.4",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.7.3"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "auto",
    "htmlWhitespaceSensitivity": "css",
    "jsxBracketSameLine": true,
    "printWidth": 120,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "semi": true,
    "singleAttributePerLine": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
